# Keep the build context small and out of credentials.
.git
.gitignore
**/.env
**/.env.*
!**/.env.example

node_modules
target
dist
artifacts
npm
.publish
.vitest

**/*.log
scripts/hooks/_

# Auth keys and overlay files must not enter the build context or cache.
**/secrets/
deploy/config/
*.key
!src/fixtures/**/*.key
.azure
.vscode

