# Copy to .env in the repository root and pass `--env-file .env` from that root,
# e.g. `docker compose -f deploy/compose.yml --env-file .env up`.
# No secrets belong in this file or in the image.

# Address the process binds in the container. Must be 0.0.0.0 for published ports.
HOST=0.0.0.0

# Host and container port. Both sides of the compose mapping use this value.
PORT=3000
