{
  "name": "@alloy-ts/net",
  "version": "0.0.0",
  "description": "Hono-style HTTP server for alloy-ts, implemented in Rust on Rocket over N-API.",
  "keywords": [
    "hono",
    "http",
    "napi",
    "rocket",
    "server"
  ],
  "license": "Unlicense",
  "author": "Yumin Chen",
  "repository": {
    "type": "git",
    "url": "git+https://repo.chen.software/alloy-ts/net.git"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.mjs",
    "dist/index.d.mts",
    "dist/cloud.mjs",
    "dist/cloud.d.mts"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cloud": "./dist/cloud.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node --import @oxc-node/core/register build.ts && vp pack",
    "dev": "vp pack --watch",
    "start": "node --import @oxc-node/core/register examples/server.ts",
    "test": "node --import @oxc-node/core/register --test 'scripts/**/*.test.ts' && vp test --run --maxWorkers=1 && cargo test",
    "check": "vp check && npm run check:types && cargo check --all-targets",
    "check:types": "tsc -p tsconfig.types.json",
    "fmt": "vp fmt && cargo fmt",
    "lint": "vp lint && cargo clippy --all-targets",
    "fix": "vp fmt && cargo clippy --fix --all-targets --allow-dirty --allow-staged && vp check --fix",
    "prepublishOnly": "npm run build",
    "prepare": "node --import @oxc-node/core/register scripts/setup.ts",
    "repo:sanity": "node --import @oxc-node/core/register scripts/repo-sanity.ts",
    "ci": "node --import @oxc-node/core/register scripts/ci.ts",
    "publish:npm": "node --import @oxc-node/core/register scripts/publish.ts"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/cli": "^3.10.8",
    "@oxc-node/core": "^0.1.7",
    "@types/node": "^26.6.5",
    "emnapi": "^1.11.3",
    "vite-plus": "1.6.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "napi": {
    "binaryName": "alloy-net",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.11.0",
      "onFail": "warn"
    }
  },
  "inlinedDependencies": {
    "undici-types": "8.9.0"
  }
}
